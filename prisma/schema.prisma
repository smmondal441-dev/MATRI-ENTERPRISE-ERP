// ============================================================================
// FMCG Distribution House ERP — Prisma schema (PostgreSQL backend)
// ----------------------------------------------------------------------------
// This schema mirrors the local Dexie.js (IndexedDB) tables so that the
// offline-first SyncService can push local records up to a central
// PostgreSQL database for backup / multi-device sync.
//
// Provider: postgresql
// Connection: DATABASE_URL env var (e.g. postgresql://user:pass@host:5432/db)
//
// All tables use the local Dexie `id` (auto-increment integer) as the primary
// key so that the SyncService can upsert by the same id on the server side.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Product Master
// ----------------------------------------------------------------------------

model Product {
  id                            Int      @id
  sku                           String
  companyName                   String   @map("company_name")
  name                          String
  category                      String?
  hsnCode                       String   @map("hsn_code")
  baseUnit                      String   @map("base_unit")
  outerUnit                     String   @map("outer_unit")
  conversionFactor             Float    @map("conversion_factor")
  packSize                      String?  @map("pack_size")

  // v4 per-piece pricing
  purchaseRatePerOuterUnit      Float    @map("purchase_rate_per_outer_unit")
  purchaseRatePerPiece          Float    @map("purchase_rate_per_piece")
  sellingRatePerPiece           Float    @map("selling_rate_per_piece")
  sellingRatePerOuterUnit       Float    @map("selling_rate_per_outer_unit")

  // Legacy aliases (kept for backward compat with v1-v3 client rows)
  purchaseRate                  Float?   @map("purchase_rate")
  salesRate                     Float?   @map("sales_rate")
  purchaseRatePerPcs            Float?   @map("purchase_rate_per_pcs")
  salesRatePerPcs               Float?   @map("sales_rate_per_pcs")

  gstPercent                    Float    @map("gst_percent")
  openingStockPcs               Float    @map("opening_stock_pcs")
  createdAt                     DateTime @map("created_at")
  syncedAt                      DateTime? @map("synced_at")

  @@map("products")
}

// ----------------------------------------------------------------------------
// Customer Master
// ----------------------------------------------------------------------------

model Customer {
  id              Int      @id
  customerId      String   @map("customer_id")
  name            String
  routeArea       String   @map("route_area")
  phone           String
  gstin           String?
  openingBalance  Float    @map("opening_balance")
  createdAt       DateTime @map("created_at")
  syncedAt        DateTime? @map("synced_at")

  @@map("customers")
}

// ----------------------------------------------------------------------------
// Purchase Entry
// ----------------------------------------------------------------------------

model Purchase {
  id              Int      @id
  billNo          String   @map("bill_no")
  date            String
  supplierName    String   @map("supplier_name")
  supplierGstin   String?  @map("supplier_gstin")
  productId       Int      @map("product_id")
  productSku      String   @map("product_sku")
  productName     String   @map("product_name")
  hsnCode         String   @map("hsn_code")
  bagQty          Float    @map("bag_qty")
  pcsQty          Float    @map("pcs_qty")
  totalPcs        Float    @map("total_pcs")
  purchaseRate    Float    @map("purchase_rate")
  gstPercent      Float    @map("gst_percent")
  taxableAmount   Float    @map("taxable_amount")
  cgst            Float
  sgst            Float
  totalAmount     Float    @map("total_amount")
  createdAt       DateTime @map("created_at")
  syncedAt        DateTime? @map("synced_at")

  @@map("purchases")
}

// ----------------------------------------------------------------------------
// Sale (invoice header)
// ----------------------------------------------------------------------------

model Sale {
  id                  Int      @id
  invoiceNo           String   @map("invoice_no")
  date                String
  customerId          Int      @map("customer_id")
  customerName        String   @map("customer_name")
  paymentMode         String   @map("payment_mode")
  subtotal            Float
  cgst                Float
  sgst                Float
  totalAmount         Float    @map("total_amount")
  totalProfit         Float    @map("total_profit")
  totalMarginPercent  Float    @map("total_margin_percent")
  paidAmount          Float    @map("paid_amount")
  createdAt           DateTime @map("created_at")
  syncedAt            DateTime? @map("synced_at")

  @@map("sales")
}

// ----------------------------------------------------------------------------
// Sale Item (line items)
// ----------------------------------------------------------------------------

model SaleItem {
  id                  Int      @id
  saleId              Int      @map("sale_id")
  productId           Int      @map("product_id")
  productName         String   @map("product_name")
  productSku          String   @map("product_sku")
  hsnCode             String   @map("hsn_code")
  quantityPcs         Float    @map("quantity_pcs")
  rate                Float
  gstPercent          Float    @map("gst_percent")
  taxableAmount       Float    @map("taxable_amount")
  cgst                Float
  sgst                Float
  total               Float
  purchaseRate        Float    @map("purchase_rate")
  itemProfit          Float    @map("item_profit")
  itemMarginPercent   Float    @map("item_margin_percent")
  createdAt           DateTime @default(now()) @map("created_at")
  syncedAt            DateTime? @map("synced_at")

  @@map("sale_items")
}

// ----------------------------------------------------------------------------
// Collection (customer payment receipt)
// ----------------------------------------------------------------------------

model Collection {
  id              Int      @id
  date            String
  customerId      Int      @map("customer_id")
  customerName    String   @map("customer_name")
  amount          Float
  paymentMode     String   @map("payment_mode")
  notes           String?
  createdAt       DateTime @map("created_at")
  syncedAt        DateTime? @map("synced_at")

  @@map("collections")
}

// ----------------------------------------------------------------------------
// Distributor Settings
// ----------------------------------------------------------------------------

model DistributorSetting {
  id              Int      @id
  storeName       String   @map("store_name")
  subtitle        String?
  gstin           String
  address         String
  phone           String
  email           String
  logoUrl         String?  @map("logo_url")
  invoicePrefix   String   @map("invoice_prefix")
  state           String
  bankDetails     String?  @map("bank_details")
  syncedAt        DateTime? @map("synced_at")

  @@map("distributor_settings")
}

// ----------------------------------------------------------------------------
// Damage / Stock Adjustment
// ----------------------------------------------------------------------------

model Damage {
  id              Int      @id
  date            String
  productId       Int      @map("product_id")
  productSku      String   @map("product_sku")
  productName     String   @map("product_name")
  hsnCode         String   @map("hsn_code")
  bagQty          Float    @map("bag_qty")
  pcsQty          Float    @map("pcs_qty")
  totalPcs        Float    @map("total_pcs")
  reason          String
  notes           String?
  expenseValue    Float    @map("expense_value")
  createdAt       DateTime @map("created_at")
  syncedAt        DateTime? @map("synced_at")

  @@map("damages")
}

// ----------------------------------------------------------------------------
// Purchase Return (return TO supplier)
// ----------------------------------------------------------------------------

model PurchaseReturn {
  id                       Int      @id
  date                     String
  originalPurchaseId       Int?     @map("original_purchase_id")
  returnNo                 String   @map("return_no")
  supplierName             String   @map("supplier_name")
  supplierGstin             String?  @map("supplier_gstin")
  productId                Int      @map("product_id")
  productSku               String   @map("product_sku")
  productName              String   @map("product_name")
  hsnCode                  String   @map("hsn_code")
  bagQty                   Float    @map("bag_qty")
  pcsQty                   Float    @map("pcs_qty")
  totalPcs                 Float    @map("total_pcs")
  purchaseRate             Float    @map("purchase_rate")
  purchaseRatePerPcs       Float    @map("purchase_rate_per_pcs")
  gstPercent               Float    @map("gst_percent")
  taxableAmount            Float    @map("taxable_amount")
  cgst                     Float
  sgst                     Float
  totalAmount              Float    @map("total_amount")
  reason                   String?
  createdAt                DateTime @map("created_at")
  syncedAt                 DateTime? @map("synced_at")

  @@map("purchase_returns")
}

// ----------------------------------------------------------------------------
// Sales Return (return FROM customer)
// ----------------------------------------------------------------------------

model SalesReturn {
  id                  Int      @id
  date                String
  originalSaleId      Int?     @map("original_sale_id")
  returnNo            String   @map("return_no")
  customerId          Int      @map("customer_id")
  customerName        String   @map("customer_name")
  productId           Int      @map("product_id")
  productSku          String   @map("product_sku")
  productName         String   @map("product_name")
  hsnCode             String   @map("hsn_code")
  bagQty              Float    @map("bag_qty")
  pcsQty              Float    @map("pcs_qty")
  totalPcs            Float    @map("total_pcs")
  salesRatePerPcs     Float    @map("sales_rate_per_pcs")
  gstPercent          Float    @map("gst_percent")
  taxableAmount       Float    @map("taxable_amount")
  cgst                Float
  sgst                Float
  totalAmount         Float    @map("total_amount")
  restock             Boolean
  reason              String?
  createdAt           DateTime @map("created_at")
  syncedAt            DateTime? @map("synced_at")

  @@map("sales_returns")
}

// ----------------------------------------------------------------------------
// SyncAuditLog — optional audit trail of sync events for debugging
// ----------------------------------------------------------------------------

model SyncAuditLog {
  id           Int      @id @default(sequence())
  eventType    String   @map("event_type") // 'push' | 'pull' | 'online' | 'offline' | 'error'
  entityType   String?  @map("entity_type") // 'product' | 'sale' | ...
  entityId     Int?     @map("entity_id")
  recordCount  Int?     @map("record_count")
  status       String   // 'success' | 'failure' | 'partial'
  message      String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sync_audit_logs")
}
