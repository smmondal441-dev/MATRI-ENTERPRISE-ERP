// ============================================================================
// FMCG Distribution House ERP — Prisma schema (Turso / libSQL / SQLite)
// ----------------------------------------------------------------------------
// v5 — ALL integer fields changed to BigInt
//
// ALL integer columns are now BigInt (64-bit). This prevents overflow errors
// when data migrated from CockroachDB (which uses unique_rowid() = 64-bit)
// is stored in columns that were previously Int (32-bit).
//
// The libSQL client uses intMode: 'bigint' in db.ts, which returns ALL
// integers as native BigInt. Prisma's BigInt type accepts these natively.
//
// The sync routes' bigIntReplacer + toNum() helpers handle the conversion
// between BigInt (server) and number (client/Dexie).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./prisma-dummy.db"
}

// ----------------------------------------------------------------------------
// Product Master
// ----------------------------------------------------------------------------

model Product {
  id                            BigInt   @id @default(autoincrement())
  localId                       BigInt   @unique @map("local_id")
  sku                           String
  companyName                   String   @map("company_name")
  name                          String
  category                      String?
  hsnCode                       String   @map("hsn_code")
  baseUnit                      String   @map("base_unit")
  outerUnit                     String   @map("outer_unit")
  conversionFactor             Float    @map("conversion_factor")
  packSize                      String?  @map("pack_size")
  // Loose Product flag — when true, the product is sold by weight (Kg/Gm)
  // instead of packaged units (Bag/Peti). conversion_factor is forced to 1
  // and outer_unit is forced to base_unit so the pricing math stays identical
  // (per-piece == per-outer when cf=1). Defaults to false → all existing
  // packaged products remain unchanged.
  isLoose                       Boolean  @default(false) @map("is_loose")
  purchaseRatePerOuterUnit      Float    @map("purchase_rate_per_outer_unit")
  purchaseRatePerPiece          Float    @map("purchase_rate_per_piece")
  sellingRatePerPiece           Float    @map("selling_rate_per_piece")
  sellingRatePerOuterUnit       Float    @map("selling_rate_per_outer_unit")
  purchaseRate                  Float?   @map("purchase_rate")
  salesRate                     Float?   @map("sales_rate")
  purchaseRatePerPcs            Float?   @map("purchase_rate_per_pcs")
  salesRatePerPcs               Float?   @map("sales_rate_per_pcs")
  gstPercent                    Float    @map("gst_percent")
  openingStockPcs               Float    @map("opening_stock_pcs")
  // Soft Delete (Recycle Bin) — when true, the row is hidden from the main UI
  // and moved to the Recycle Bin. Restore sets it back to false. Defaults to
  // false → all existing rows remain visible.
  isDeleted                     Boolean  @default(false) @map("is_deleted")
  createdAt                     DateTime @map("created_at")
  syncedAt                      DateTime? @map("synced_at")
  @@map("products")
}

// ----------------------------------------------------------------------------
// Customer Master
// ----------------------------------------------------------------------------

model Customer {
  id              BigInt   @id @default(autoincrement())
  localId         BigInt   @unique @map("local_id")
  customerId      String   @map("customer_id")
  name            String
  routeArea       String   @map("route_area")
  phone           String
  gstin           String?
  openingBalance  Float    @map("opening_balance")
  billNumber      String?  @map("bill_number")
  isDeleted       Boolean  @default(false) @map("is_deleted")
  customerType    String?  @map("customer_type")
  createdAt       DateTime @map("created_at")
  syncedAt        DateTime? @map("synced_at")
  @@map("customers")
}

// ----------------------------------------------------------------------------
// Purchase Entry
// ----------------------------------------------------------------------------

model Purchase {
  id              BigInt   @id @default(autoincrement())
  localId         BigInt   @unique @map("local_id")
  billNo          String   @map("bill_no")
  date            String
  supplierName    String   @map("supplier_name")
  supplierGstin   String?  @map("supplier_gstin")
  productId       BigInt   @map("product_id")
  productSku      String   @map("product_sku")
  productName     String   @map("product_name")
  hsnCode         String   @map("hsn_code")
  bagQty          Float    @map("bag_qty")
  pcsQty          Float    @map("pcs_qty")
  totalPcs        Float    @map("total_pcs")
  purchaseRate    Float    @map("purchase_rate")
  gstPercent      Float    @map("gst_percent")
  taxableAmount   Float    @map("taxable_amount")
  cgst            Float
  sgst            Float
  totalAmount     Float    @map("total_amount")
  mfgDate         String?  @map("mfg_date")
  expiryDate      String?  @map("expiry_date")
  isDeleted       Boolean  @default(false) @map("is_deleted")
  createdAt       DateTime @map("created_at")
  syncedAt        DateTime? @map("synced_at")
  @@map("purchases")
}

// ----------------------------------------------------------------------------
// Sale (invoice header)
// ----------------------------------------------------------------------------

model Sale {
  id                  BigInt   @id @default(autoincrement())
  localId             BigInt   @unique @map("local_id")
  invoiceNo           String   @map("invoice_no")
  date                String
  customerId          BigInt   @map("customer_id")
  customerName        String   @map("customer_name")
  paymentMode         String   @map("payment_mode")
  subtotal            Float
  cgst                Float
  sgst                Float
  totalAmount         Float    @map("total_amount")
  totalProfit         Float    @map("total_profit")
  totalMarginPercent  Float    @map("total_margin_percent")
  paidAmount          Float    @map("paid_amount")
  isDeleted           Boolean  @default(false) @map("is_deleted")
  createdAt           DateTime @map("created_at")
  syncedAt            DateTime? @map("synced_at")
  @@map("sales")
}

// ----------------------------------------------------------------------------
// Sale Item (line items)
// ----------------------------------------------------------------------------

model SaleItem {
  id                  BigInt   @id @default(autoincrement())
  localId             BigInt   @unique @map("local_id")
  saleLocalId         BigInt   @map("sale_local_id")
  productId           BigInt   @map("product_id")
  productName         String   @map("product_name")
  productSku          String   @map("product_sku")
  hsnCode             String   @map("hsn_code")
  quantityPcs         Float    @map("quantity_pcs")
  rate                Float
  gstPercent          Float    @map("gst_percent")
  taxableAmount       Float    @map("taxable_amount")
  cgst                Float
  sgst                Float
  total               Float
  purchaseRate        Float    @map("purchase_rate")
  itemProfit          Float    @map("item_profit")
  itemMarginPercent   Float    @map("item_margin_percent")
  isDeleted           Boolean  @default(false) @map("is_deleted")
  createdAt           DateTime @default(now()) @map("created_at")
  syncedAt            DateTime? @map("synced_at")
  @@map("sale_items")
}

// ----------------------------------------------------------------------------
// Collection (customer payment receipt)
// ----------------------------------------------------------------------------

model Collection {
  id              BigInt   @id @default(autoincrement())
  localId         BigInt   @unique @map("local_id")
  date            String
  customerId      BigInt   @map("customer_id")
  customerName    String   @map("customer_name")
  amount          Float
  paymentMode     String   @map("payment_mode")
  notes           String?
  // Bill-by-bill allocation (Tally-style "Against Reference").
  // Stored as a JSON-stringified array of { sale_id, invoice_no, amount }
  // so a single Collection receipt can be split across multiple invoices.
  // Null / empty for legacy lump-sum collections — fully backward compatible.
  billAllocations String?  @map("bill_allocations")
  createdAt       DateTime @map("created_at")
  syncedAt        DateTime? @map("synced_at")
  @@map("collections")
}

// ----------------------------------------------------------------------------
// Distributor Settings
// ----------------------------------------------------------------------------

model DistributorSetting {
  id              BigInt   @id @default(autoincrement())
  localId         BigInt   @unique @map("local_id")
  storeName       String   @map("store_name")
  subtitle        String?
  gstin           String
  address         String
  phone           String
  email           String
  logoUrl         String?  @map("logo_url")
  invoicePrefix   String   @map("invoice_prefix")
  state           String
  bankDetails     String?  @map("bank_details")
  syncedAt        DateTime? @map("synced_at")
  @@map("distributor_settings")
}

// ----------------------------------------------------------------------------
// Damage / Stock Adjustment
// ----------------------------------------------------------------------------

model Damage {
  id              BigInt   @id @default(autoincrement())
  localId         BigInt   @unique @map("local_id")
  date            String
  productId       BigInt   @map("product_id")
  productSku      String   @map("product_sku")
  productName     String   @map("product_name")
  hsnCode         String   @map("hsn_code")
  bagQty          Float    @map("bag_qty")
  pcsQty          Float    @map("pcs_qty")
  totalPcs        Float    @map("total_pcs")
  reason          String
  notes           String?
  expenseValue    Float    @map("expense_value")
  // Upgrade 3 — Damage Source: Godown vs Store
  //   "godown" → deducts from sellable inventory stock (default; backward
  //              compatible — existing rows get this value on first read).
  //   "store"  → does NOT touch sellable stock; tracked separately as
  //              "Damaged Stock (Store)" in Inventory.
  damageSource    String   @default("godown") @map("damage_source")
  // Optional customer/store reference when damage_source = "store". Null for
  // godown damages. Nullable + optional so old rows and old clients remain
  // compatible without a data migration.
  customerId      BigInt?  @map("customer_id")
  // Denormalized customer_name for fast display in the Damages log without
  // needing to join/lookup the customer by id. Nullable + optional so old
  // rows and old clients remain compatible without a data migration.
  customerName    String?  @map("customer_name")
  // Task 2 — Bill-wise damage allocation. When a store-return damage is
  // attributed to a specific sale/invoice, the damage amount is deducted
  // from that bill's "Net Payable" in the Collection screen (Tally-style
  // adjustment). Both nullable so existing damage records are unaffected.
  saleId          BigInt?  @map("sale_id")
  againstInvoiceNo String? @map("against_invoice_no")
  createdAt       DateTime @map("created_at")
  syncedAt        DateTime? @map("synced_at")
  @@map("damages")
}

// ----------------------------------------------------------------------------
// Purchase Return (return TO supplier)
// ----------------------------------------------------------------------------

model PurchaseReturn {
  id                       BigInt   @id @default(autoincrement())
  localId                  BigInt   @unique @map("local_id")
  date                     String
  originalPurchaseId       BigInt?  @map("original_purchase_id")
  returnNo                 String   @map("return_no")
  supplierName             String   @map("supplier_name")
  supplierGstin            String?  @map("supplier_gstin")
  productId                BigInt   @map("product_id")
  productSku               String   @map("product_sku")
  productName              String   @map("product_name")
  hsnCode                  String   @map("hsn_code")
  bagQty                   Float    @map("bag_qty")
  pcsQty                   Float    @map("pcs_qty")
  totalPcs                 Float    @map("total_pcs")
  purchaseRate             Float    @map("purchase_rate")
  purchaseRatePerPcs       Float    @map("purchase_rate_per_pcs")
  gstPercent               Float    @map("gst_percent")
  taxableAmount            Float    @map("taxable_amount")
  cgst                     Float
  sgst                     Float
  totalAmount              Float    @map("total_amount")
  reason                   String?
  createdAt                DateTime @map("created_at")
  syncedAt                 DateTime? @map("synced_at")
  @@map("purchase_returns")
}

// ----------------------------------------------------------------------------
// Sales Return (return FROM customer)
// ----------------------------------------------------------------------------

model SalesReturn {
  id                  BigInt   @id @default(autoincrement())
  localId             BigInt   @unique @map("local_id")
  date                String
  originalSaleId      BigInt?  @map("original_sale_id")
  returnNo            String   @map("return_no")
  customerId          BigInt   @map("customer_id")
  customerName        String   @map("customer_name")
  productId           BigInt   @map("product_id")
  productSku          String   @map("product_sku")
  productName         String   @map("product_name")
  hsnCode             String   @map("hsn_code")
  bagQty              Float    @map("bag_qty")
  pcsQty              Float    @map("pcs_qty")
  totalPcs            Float    @map("total_pcs")
  salesRatePerPcs     Float    @map("sales_rate_per_pcs")
  gstPercent          Float    @map("gst_percent")
  taxableAmount       Float    @map("taxable_amount")
  cgst                Float
  sgst                Float
  totalAmount         Float    @map("total_amount")
  restock             Boolean
  reason              String?
  createdAt           DateTime @map("created_at")
  syncedAt            DateTime? @map("synced_at")
  @@map("sales_returns")
}

// ----------------------------------------------------------------------------
// SyncAuditLog — audit trail of sync events for debugging
// ----------------------------------------------------------------------------

model SyncAuditLog {
  id           BigInt   @id @default(autoincrement())
  eventType    String   @map("event_type")
  entityType   String?  @map("entity_type")
  entityId     BigInt?  @map("entity_id")
  recordCount  BigInt?  @map("record_count")
  status       String
  message      String?
  createdAt    DateTime @default(now()) @map("created_at")
  @@map("sync_audit_logs")
}
